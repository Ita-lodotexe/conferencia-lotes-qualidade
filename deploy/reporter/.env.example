# === Configurações Bot C (Reporter) ===

# Modo de execução Maestro
MAESTRO_ENABLED=true

# Credenciais do BotCity Maestro
BOTCITY_WORKSPACE=lg-cmdi
BOTCITY_SERVER=https://lgcmdi.botcity.dev
BOTCITY_LOGIN=lg-cmdi
BOTCITY_KEY=

# Activity Labels
BOTCITY_DISPATCHER_LABEL=italo-dispatcher-v1
BOTCITY_PERFORMER_LABEL=italo-performer-v1
BOTCITY_REPORTER_LABEL=italo-reporter-v1

# Caminhos de Saída
PASTA_SAIDA=data/output

# === Canais de Notificação e Alertas (Fallback Multi-Canal) ===
# Canal Principal (Telegram)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Canal Alternativo de Fallback (Email SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DESTINATION=
