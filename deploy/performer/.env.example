# === Configurações Bot B (Performer) ===

# Modo de execução Maestro e Credentials Vault
MAESTRO_ENABLED=true
VAULT_ENABLED=false

# Credenciais do BotCity Maestro
BOTCITY_WORKSPACE=
BOTCITY_SERVER=
BOTCITY_LOGIN=
BOTCITY_KEY=

# Fila de Itens e Labels de Orquestração
DATAPOOL_LABEL=FilaAuditoriaLotes-Eqp04
BOTCITY_DISPATCHER_LABEL=italo-dispatcher-v1
BOTCITY_PERFORMER_LABEL=italo-performer-v1
BOTCITY_REPORTER_LABEL=italo-reporter-v1

# Credentials Vault (ERP)
VAULT_CREDENCIAL_ERP_LABEL=credencial_erp_eqp04

# Caminhos de Entrada e Referência
PASTA_ENTRADA=data/processed
ARQUIVO_CSV_ENTRADA=dados_relatorio.csv
CAMINHO_BASE_REFERENCIA=data/processed/base_lotes_referencia.csv

# Classificador de Machine Learning (Estudo de Caso S10-B)
ML_ENABLED=true
ML_CONFIANCA_MINIMA=0.75
ML_ENDPOINT=http://127.0.0.1:8000
