# === Flags de execução ===
# Se true, o bot integra com o BotCity Maestro (fila, artefatos, alertas).
# Se false, roda em modo local sem contatar o Maestro.
MAESTRO_ENABLED=false

# Se true, credenciais são lidas do Credentials Vault do Maestro.
# Se false, usa credenciais fictícias para desenvolvimento local.
VAULT_ENABLED=false

# === Caminhos ===
# Pasta onde o Dispatcher lê o CSV de lotes a serem enviados à fila.
PASTA_ENTRADA=dados_entrada

# === Credenciais de conexão do SDK BotCity ===
# Obtidos em https://developers.botcity.dev/app/ → Ambiente do desenvolvedor
BOTCITY_WORKSPACE=lg-cmdi

# URL do servidor Maestro (subdomínio único do workspace).
# Exemplo: https://lgcmdi.botcity.dev — é o que aparece no navegador
# ao acessar o painel do workspace.
BOTCITY_SERVER=https://lgcmdi.botcity.dev

BOTCITY_LOGIN=preencher_com_login_do_painel
BOTCITY_KEY=preencher_com_chave_do_painel
