# Example environment variables and local defaults

# General execution identifiers
EXECUTION_ID=local-001
BOT_ID=conferencia-bot

# Application URL used for local UI tests (lote-teste.html)
APP_URL=http://host.docker.internal:8000/lote-teste.html

# === Flags de execução ===
# Se true, o bot integra com o BotCity Maestro (fila, artefatos, alertas).
# Se false, roda em modo local sem contatar o Maestro.
MAESTRO_ENABLED=false

# Se true, credenciais são lidas do Credentials Vault do Maestro.
# Se false, usa credenciais fictícias para desenvolvimento local.
VAULT_ENABLED=false

# === Caminhos ===
# Pasta onde o Dispatcher lê o CSV de lotes a serem enviados à fila.
PASTA_ENTRADA=dados_entrada

# === Credenciais de conexão do SDK BotCity ===
BOTCITY_WORKSPACE=
# URL do servidor Maestro (subdomínio único do workspace).
BOTCITY_SERVER=
BOTCITY_LOGIN=preencher_com_login_do_painel
BOTCITY_KEY=preencher_com_chave_do_painel

# Labels 
BOTCITY_DISPATCHER_LABEL=italo-dispatcher-v1
BOTCITY_PERFORMER_LABEL=italo-performer-v1
BOTCITY_REPORTER_LABEL=italo-reporter-v1

# Activity label da Automation cadastrada no painel do Maestro.
BOTCITY_ACTIVITY_LABEL=performer-lotes-<sufixo_do_grupo>



# Variaveis para o ML:
ML_ENABLED = true
ML_CONFIANCA_MINIMA = 0.75
ML_ENDPOINT = 

# Canal Principal (Telegram)
TELEGRAM_TOKEN=preencher_com_o_token_do_botfather
TELEGRAM_CHAT_ID=preencher_com_o_id_do_grupo

# OU Canal Alternativo de Fallback (Exemplo: Email SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=preencher_com_email
SMTP_PASSWORD=preencher_com_senha_de_app