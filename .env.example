# Arquivo de exemplo para configuração do pipeline (copie para .env)
# NUNCA comite o .env com valores reais — use este .env.example como template.
# === Identificadores de execução ===
EXECUTION_ID=local-001
BOT_ID=conferencia-bot

# URL da aplicação para testes locais de UI
APP_URL=http://host.docker.internal:8000/lote-teste.html

# === Flags de execução ===
# true  → integra com BotCity Maestro (fila, artefatos, alertas)
# false → roda em modo local sem contatar o Maestro
MAESTRO_ENABLED=false

# true  → credenciais lidas do Credentials Vault do Maestro
# false → usa credenciais fictícias para desenvolvimento local
VAULT_ENABLED=false

# === Caminhos ===
PASTA_ENTRADA=dados_entrada
PASTA_SAIDA=data/output
ARQUIVO_CSV_ENTRADA=dados_relatorio.csv
CAMINHO_BASE_REFERENCIA=data/processed/base_lotes_referencia.csv

# === Credenciais do SDK BotCity Maestro ===
BOTCITY_WORKSPACE=
BOTCITY_SERVER=
BOTCITY_LOGIN=preencher_com_login_do_painel
BOTCITY_KEY=preencher_com_chave_do_painel

# Labels das automações registradas no Maestro (nome_aluno-nome_bot-versao)
BOTCITY_DISPATCHER_LABEL=italo-dispatcher-v1
BOTCITY_PERFORMER_LABEL=italo-performer-v1
BOTCITY_REPORTER_LABEL=italo-reporter-v1
BOTCITY_ACTIVITY_LABEL=italo-performer-v1

# Label do DataPool (fila de itens)
DATAPOOL_LABEL=FilaAuditoriaLotes-Eqp04

# === Machine Learning ===
# true  → bot consulta o endpoint de predição (ML_ENDPOINT)
# false → retorna fallback imediato sem chamada HTTP (motivo_fallback: ml_desabilitado)
ML_ENABLED=true
# Predições com confiança abaixo deste limiar são descartadas (fallback: baixa_confianca)
ML_CONFIANCA_MINIMA=0.75
# Endpoint da API de ML (local via Docker ou remoto)
ML_ENDPOINT=http://127.0.0.1:8000

# === Canal Principal de Notificação — Telegram ===
TELEGRAM_TOKEN=preencher_com_o_token_do_botfather
TELEGRAM_CHAT_ID=preencher_com_o_id_do_grupo_ou_canal

# === Canal Secundário de Fallback — Email SMTP ===
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=preencher_com_email
SMTP_PASSWORD=preencher_com_senha_de_app
EMAIL_DESTINATION=preencher_com_email_destinatario

# === Canal Terciário de Fallback — WhatsApp via Twilio ===
TWILIO_ACCOUNT_SID=preencher_com_account_sid
TWILIO_AUTH_TOKEN=preencher_com_auth_token
TWILIO_PHONE_NUMBER=+14155238886
WHATSAPP_DESTINATION=+55119XXXXXXXX